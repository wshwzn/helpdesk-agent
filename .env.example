# 本地安全配置。复制为 .env 后填写，禁止提交真实值。
JWT_SECRET=
MODEL_CONFIG_ENCRYPTION_KEY=

# 流式请求上限，以及中断回答的恢复阈值和扫描周期。
APP_CHAT_STREAM_TIMEOUT=5m
# PENDING 恢复阈值必须大于流式请求上限。
CHAT_PENDING_TIMEOUT=10m
CHAT_PENDING_RECOVERY_INTERVAL=1m

# local 适合本地开发；接入阿里云时改为 aliyun-oss。
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT_DIRECTORY=./data/objects
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 文档解析与分块参数，通常保持默认值即可。
KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16

# Elasticsearch 使用 HTTPS 时填写安装目录生成的 CA 证书。
ELASTIC_URI=https://localhost:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=
ELASTIC_CA_CERT_PATH=D:/elasticsearch-9.5.4/config/certs/http_ca.crt
ELASTIC_INDEX_NAME=helpdesk_knowledge_chunks_v1
ELASTIC_REQUEST_TIMEOUT=30s
